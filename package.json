{
  "name": "traffic-mcmt-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time MCMT track visualization (deck.gl + MapLibre GL JS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf": "node scripts/perf-smoke.mjs",
    "mock": "python mock/mock_server.py"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@deck.gl/react": "^9.4.1",
    "deck.gl": "^9.4.1",
    "maplibre-gl": "6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
