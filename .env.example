# WebSocket endpoint of the TrafficMCMT backend (stage 2)
VITE_WS_URL=ws://localhost:8080/ws

# Reconnect after this much silence, ms. The gateway sends a heartbeat every
# feed.heartbeat_s (5 s by default), so this tolerates two missed beats.
VITE_WS_TIMEOUT_MS=15000

# Drop tracks that have not been updated for this long, ms
VITE_TRACK_TTL_MS=8000

# Dead-reckon markers between 10 Hz frames (set to false to compare raw data)
VITE_MAP_ANIMATE=true

# Fit the map once to the first camera zones (Aire or Auburn).
VITE_MAP_AUTOFIT=true

# MapLibre style; CARTO dark matter requires no token
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Initial view: Aire (France) test area
VITE_MAP_LON=5.9745
VITE_MAP_LAT=45.5268
VITE_MAP_ZOOM=16
